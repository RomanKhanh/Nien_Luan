DB_URL=jdbc:postgresql://localhost:5432/brainblocks
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
# Đăng nhập Google: OAuth Client ID (dạng xxx.apps.googleusercontent.com), KHÔNG phải GOOGLE_API_KEY của Gemini
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@brainblocks.local

# SMTP used for email verification, including Facebook email fallback.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=BrainBlocks
ADMIN_PASSWORD=
SEED_DEMO_DATA=false
UPLOAD_DIR=uploads
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Chatbot AI: API key Gemini (Google AI Studio). Bỏ trống thì app vẫn chạy, chỉ chatbot trả 503.
GOOGLE_API_KEY=
# Tìm kiếm vector (pgvector, xem docs/pgvector-setup.md); bỏ trống dùng mặc định
# PRODUCT_EMBEDDING_BACKFILL=true
# CHAT_SEMANTIC_PRODUCTS_MIN_SCORE=0.65
# CHAT_SEMANTIC_PRODUCTS_LIMIT=8

# Facebook Login (App Secret must stay on the backend). See docs/facebook-login.md.
FACEBOOK_APP_ID=4489509117982849
FACEBOOK_APP_SECRET=8302ce45e3cf5c97835c23caac8bd96e
FACEBOOK_API_VERSION=v24.0
