# Sao chép thành .env rồi điền giá trị. Vite chỉ đưa ra trình duyệt các biến bắt đầu bằng VITE_.

# Đăng nhập Google: OAuth 2.0 Client ID loại "Web application" (dạng xxx.apps.googleusercontent.com),
# phải TRÙNG với GOOGLE_CLIENT_ID của backend. Để trống thì trang đăng nhập ẩn nút Google.
VITE_GOOGLE_CLIENT_ID=

# Public Facebook App ID, same as backend. NEVER add App Secret here.
VITE_FACEBOOK_APP_ID=4489509117982849
VITE_FACEBOOK_API_VERSION=v24.0
